# Copy this file to server/.env and fill in SMTP_PASSWORD.
# server/.env is ignored by git: never commit the real password.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=ramzi.hachicha@hachichaadvisory.com
SMTP_PASSWORD=
MAIL_FROM=ramzi.hachicha@hachichaadvisory.com
MAIL_TO=ramzi.hachicha@hachichaadvisory.com

# Port the contact API listens on.
PORT=3001

# Comma-separated list of website origins allowed to call the API
# (only needed when the website and the API are on different domains).
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
